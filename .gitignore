.qiskit/
*.token
ibmq_credentials*

# Experiment results:
#   - published ProofRecords (*.proofrecord.json) ARE tracked (publish-regardless covenant)
#   - any other raw run artifacts are ignored
experiments/**/results/*.json
!experiments/**/results/*.proofrecord.json
!experiments/**/results/.gitkeep
